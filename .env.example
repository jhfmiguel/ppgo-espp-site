# Frontend
NEXT_PUBLIC_SITE_URL=https://espp.go.gov.br
ESPP_API_URL=http://localhost:8081
ESPP_FRONTEND_URL=http://localhost:3001

# Sessão administrativa do frontend. Obrigatório usar valor longo e aleatório em produção.
ESPP_SESSION_SECRET=

# Autenticação institucional SSP-GO.
# O painel não deve manter usuário/senha próprios em produção.
ESPP_AUTH_MODE=ssp
ESPP_SSP_ISSUER=
ESPP_SSP_JWKS_URI=
ESPP_SSP_AUDIENCE=

# API / Oracle
ESPP_API_PORT=8081
ESPP_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ESPP_DB_USERNAME=ESPP
ESPP_DB_PASSWORD=

# Chave para proteção de configurações sensíveis persistidas.
ESPP_CONFIG_ENCRYPTION_KEY=

# E-mail
ESPP_MAIL_HOST=smtp.gmail.com
ESPP_MAIL_PORT=587
ESPP_MAIL_USERNAME=
ESPP_MAIL_PASSWORD=
ESPP_MAIL_TO=

# Armazenamento de anexos
ESPP_ATTACHMENTS_DIR=C:/workspace/ppgo/espp/site-institucional/storage/mensagens
