# Frontend Next.js
ESPP_API_URL=http://localhost:8081
ESPP_SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Autenticação institucional SSP-GO
# Desenvolvimento local: development. Produção/homologação com SSP integrada: ssp.
ESPP_AUTH_MODE=development
ESPP_SSP_AUTH_URL=https://ssp.exemplo.gov.br/oauth2/authorize
ESPP_SSP_CALLBACK_URL=http://localhost:3001/admin/auth/ssp/callback
ESPP_SSP_CLIENT_ID=fornecido-pela-ssp
ESPP_SSP_SCOPE=openid profile email
ESPP_SSP_LOGOUT_URL=https://ssp.exemplo.gov.br/logout
# Endpoint de token, segredo/PKCE e claims serão configurados quando a SSP fornecer o contrato oficial.
ESPP_TEST_ADMIN_USER=defina-o-usuario-local-de-teste
ESPP_TEST_ADMIN_PASSWORD=defina-uma-senha-local-forte

# Backend Spring Boot / Oracle
ESPP_API_PORT=8081
ESPP_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ESPP_DB_USERNAME=ESPP
ESPP_DB_PASSWORD=defina-a-senha-do-banco
ESPP_JDBC_FETCH_SIZE=50
ESPP_FRONTEND_URL=http://localhost:3001
ESPP_CONFIG_ENCRYPTION_KEY=gere-uma-chave-segura
