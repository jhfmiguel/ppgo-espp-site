# ESPP 1.0.0 - modelo de producao
# Nunca versionar valores reais de segredo.

# Frontend
NEXT_PUBLIC_SITE_URL=https://espp.go.gov.br
ESPP_API_URL=https://<host-da-api-espp>
ESPP_FRONTEND_URL=https://espp.go.gov.br
ESPP_SESSION_SECRET=

# Autenticacao institucional SSP-GO
ESPP_AUTH_MODE=ssp
ESPP_SSP_ISSUER=
ESPP_SSP_JWKS_URI=
ESPP_SSP_AUDIENCE=

# API / Oracle
ESPP_API_PORT=8081
ESPP_DB_URL=jdbc:oracle:thin:@//<host-oracle>:1521/<service-name>
ESPP_DB_USERNAME=ESPP
ESPP_DB_PASSWORD=
ESPP_JDBC_FETCH_SIZE=50

# Chave longa e aleatoria para protecao de configuracoes sensiveis persistidas
ESPP_CONFIG_ENCRYPTION_KEY=

# E-mail institucional
ESPP_MAIL_HOST=
ESPP_MAIL_PORT=587
ESPP_MAIL_USERNAME=
ESPP_MAIL_PASSWORD=
ESPP_MAIL_TO=

# Diretorio persistente e gravavel para anexos
ESPP_ATTACHMENTS_DIR=/var/lib/espp/mensagens
